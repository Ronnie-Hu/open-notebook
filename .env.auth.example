# Full OpenNotebook account mode for the TAgent fork.
# Fill real secrets through the deployment secret store. Do not commit .env.
# Enable only after backing up SurrealDB and uploads, draining old jobs,
# restricting backend ports, configuring a trusted HTTPS entry, and applying
# an outbound allowlist for required internal services (database/verifier)
# while blocking other private, loopback and metadata destinations.
OPEN_NOTEBOOK_TAGENT_ACCOUNT_MODE=0

# Public notebook UI origin. The TAgent UI has the same HTTPS hostname,
# possibly on a different port. Set this in the API, worker and Next.js.
OPEN_NOTEBOOK_PUBLIC_ORIGIN=https://your-public-host:8502

# TAgent /auth/me verifier. Only the OpenNotebook API contacts this loopback URL.
OPEN_NOTEBOOK_TAGENT_VERIFIER_URL=http://127.0.0.1:5001

# Existing TAgent administrator account UUID (auth_accounts.uid); migration 27
# assigns all legacy OpenNotebook content to it. Read it from the identity
# database and verify the account before starting this migration.
OPEN_NOTEBOOK_LEGACY_ADMIN_ID=

# Generate 43-128 random URL-safe characters without base64 padding (for
# example Python secrets.token_urlsafe(48)). Pass the same private value to
# the OpenNotebook API and worker so queued jobs can verify their owner.
OPEN_NOTEBOOK_TAGENT_DB_SIGNING_KEY=

# A separate long random secret for encrypted model credentials.
OPEN_NOTEBOOK_ENCRYPTION_KEY=

# Use the existing OpenNotebook database and preserve its current data.
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook
SURREAL_USER=
SURREAL_PASSWORD=

# Next.js server-side targets. Both backends must be private loopback services.
INTERNAL_API_URL=http://127.0.0.1:5055
TAGENT_INTERNAL_URL=http://127.0.0.1:5001

# Set to 1 only when the HTTPS ingress strips client X-Real-IP, supplies the
# verified client address, and blocks direct public access to the Next.js port.
OPEN_NOTEBOOK_TRUSTED_PROXY=0
